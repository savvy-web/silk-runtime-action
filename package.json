{
	"name": "@savvy-web/silk-runtime-action",
	"version": "1.6.4",
	"private": true,
	"description": "Comprehensive Node.js runtime setup action with automatic package manager detection, dependency caching and Turbo build cache configuration",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/silk-runtime-action.git"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "turbo run build:prod --log-order=grouped",
		"build:prod": "github-action-builder build",
		"ci:build": "CI=\"true\" turbo run build:prod --log-order=grouped --output-logs=full",
		"ci:test": "CI=\"true\" vitest run --coverage",
		"ci:version": "savvy changeset version && biome format --write .",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 '**/*.{md,mdx}' --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 '**/*.{md,mdx}' --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"test": "vitest run --pass-with-no-tests",
		"test:coverage": "vitest run --coverage --pass-with-no-tests",
		"test:watch": "vitest --watch --pass-with-no-tests",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit",
		"validate": "github-action-builder validate"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/commands": "catalog:effected",
		"@effected/github-actions": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/lockfiles": "catalog:effected",
		"@effected/npm": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@effected/memfs": "catalog:effected",
		"@okfit/plugin": "^0.3.7",
		"@savvy-web/github-action-builder": "^2.3.7",
		"@savvy-web/silk": "^4.0.5",
		"@vitest-agent/plugin": "^4.0.2"
	},
	"packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.8.2",
				"onFail": "ignore"
			}
		]
	}
}
