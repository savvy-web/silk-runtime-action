{
	"name": "turbo-prepare-test",
	"version": "1.0.0",
	"description": "Turborepo workspace whose install runs a turbo build from a prepare script",
	"private": true,
	"packageManager": "pnpm@12.20.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.20.0",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.3.1",
				"onFail": "ignore"
			}
		]
	},
	"devDependencies": {
		"turbo": "2.9.18"
	}
}
